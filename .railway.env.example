# Railway Environment Variables
# Copy this to .railway.env and set actual values

# Groq API Key for AI analysis (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# JWT Secret Key (should be at least 32 characters)
SECRET_KEY=your_secret_key_here_should_be_at_least_32_chars_long

# Database URL (Railway will provide automatically)
DATABASE_URL=postgresql://user:password@host:port/database

# CORS Origins (update with your Vercel URL)
CORS_ORIGINS=["https://your-app.vercel.app"]

# API Version
API_V1_STR=/api/v1

# Token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30