# ════════════════════════════════════════════════════════════
# BACKEND CONFIGURATION
# ════════════════════════════════════════════════════════════

# Environment mode (development, staging, production)
ENVIRONMENT=development

# ── Groq API Configuration ────────────────────────────────
# Get your free API key at: https://console.groq.com/keys
# REQUIRED: Must be set in production
GROQ_API_KEY=gsk_your_api_key_here

# ── JWT & Authentication ──────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER use placeholder in production
SECRET_KEY=your-generated-secret-key-here-min-32-chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database Configuration ─────────────────────────────────
# Development: SQLite
# DATABASE_URL=sqlite:///./test.db

# Production: PostgreSQL (Railway example)
# DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_URL=postgresql://krr_user:krr_pass@localhost:5432/krr_db

# ── Redis (Rate Limiting) ──────────────────────────────────
# Development
REDIS_URL=redis://localhost:6379

# Production (Railway)
# REDIS_URL=redis://:password@host:port

# ── Server Configuration ───────────────────────────────────
PROJECT_NAME=AI Literature Review System
VERSION=2.0.0
API_V1_STR=/api/v1

# ── CORS Configuration ─────────────────────────────────────
# Development (allow localhost)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Production (set to your frontend domain)
# CORS_ORIGINS=["https://yourdomain.com"]

# ── File Upload Settings ───────────────────────────────────
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=uploads

# ════════════════════════════════════════════════════════════
# FRONTEND CONFIGURATION
# ════════════════════════════════════════════════════════════

# API Base URL
# Development
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Production (Railway backend)
# VITE_API_URL=https://your-railway-app.railway.app
