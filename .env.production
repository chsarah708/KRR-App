# ════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT VARIABLES
# ════════════════════════════════════════════════════════════

# Environment mode
ENVIRONMENT=production

# ── Groq API Configuration ────────────────────────────────
# REQUIRED: Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── JWT & Authentication ──────────────────────────────────
# REQUIRED: Generate a new secret key for production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-generated-secret-key-here

# Algorithm for JWT (default: HS256)
ALGORITHM=HS256

# Access token expiration in minutes (24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database Configuration ─────────────────────────────────
# REQUIRED: Set your production database URL
# For PostgreSQL: postgresql://user:password@host:port/database
# For SQLite: sqlite:///./krr.db (for development only)
DATABASE_URL=postgresql://user:password@host:port/database

# ── Redis Configuration ───────────────────────────────────
# REQUIRED for production (rate limiting, caching)
REDIS_URL=redis://:password@host:port

# ── CORS Configuration ──────────────────────────────────────
# REQUIRED: List all allowed frontend domains
CORS_ORIGINS=["https://your-frontend-domain.com"]

# ── File Upload Settings ────────────────────────────────────
# Maximum file size in bytes (50MB)
MAX_UPLOAD_SIZE=52428800

# Upload directory
UPLOAD_DIR=uploads