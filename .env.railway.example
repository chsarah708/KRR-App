# Railway Environment Variables
# Copy this file and set the actual values in Railway dashboard

# Groq API Key for AI analysis
GROQ_API_KEY=your_groq_api_key_here

# JWT Secret Key
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_32

# Database URL (Railway will provide this)
DATABASE_URL=postgresql://user:password@host:port/database

# CORS Origins (update with your Vercel URL)
CORS_ORIGINS=["https://your-app.vercel.app"]

# API Version
API_V1_STR=/api/v1

# Token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30